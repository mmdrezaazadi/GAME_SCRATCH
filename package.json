{
  "name": "dead-sector",
  "productName": "Dead Sector",
  "version": "1.0.0",
  "description": "Dead Sector — a detailed 3D zombie shooter built from scratch (procedural PBR models, ragdoll physics, gore FX).",
  "main": "electron/main.cjs",
  "author": {
    "name": "mmdrezaazadi",
